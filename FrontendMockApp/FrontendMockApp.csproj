<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ProjectRoot>$(MSBuildProjectDirectory)</ProjectRoot>
    <BaseOutputPath>$(ProjectRoot)/bin</BaseOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Code Examples\**\*.cs" />
    <Compile Remove="Code Examples\Java\Light\**" />
    <Compile Remove="Code Examples\Java\Medium\**" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Code Examples\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Remove="Code Examples\Java\Light\**" />
    <EmbeddedResource Remove="Code Examples\Java\Medium\**" />
    <None Remove="Code Examples\Java\Light\**" />
    <None Remove="Code Examples\Java\Medium\**" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Shared\Shared.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Folder Include="Code Examples\SQL\" />
  </ItemGroup>

</Project>
